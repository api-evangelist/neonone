            "name": "Retrieve an account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.neoncrm.com/v2/accounts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the account."
              }
            ]
          },
          "docs": "Retrieves an individual or organization account by ID. Returns 222 Merged Account if the account was merged into another."
